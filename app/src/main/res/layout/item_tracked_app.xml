<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/trackedIcon" android:layout_width="44dp" android:layout_height="44dp"
            android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/trackedName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp" />
            <TextView android:id="@+id/trackedVersion" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>
        <Button android:id="@+id/trackedMenu" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@android:color/transparent" android:text="⋮" android:textSize="24sp"
            android:textColor="@color/muted" android:contentDescription="App-Optionen" />
    </LinearLayout>
    <TextView android:id="@+id/trackedBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:textColor="@color/lime" android:textStyle="bold"
        android:textSize="11sp" android:letterSpacing="0.06" />
    <TextView android:id="@+id/trackedDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="12sp" android:lineSpacingMultiplier="1.2" />
    <Button android:id="@+id/trackedOpen" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:text="Details ansehen →"
        android:textAllCaps="false" android:textColor="@color/text" android:textSize="13sp" />
</LinearLayout>
