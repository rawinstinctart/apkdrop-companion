<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:focusableInTouchMode="true" android:id="@+id/pageRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
